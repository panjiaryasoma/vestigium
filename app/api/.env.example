# Optional environment overrides. Without them, the API automatically searches:
# <repo>/data/processed/data-engineering/vestigium_hotspots.sqlite
# <repo>/data/processed/data-engineering/monthly_sensor.csv
# <repo>/data/processed/harmonization/harmonized_calendar_monthly.csv
# <repo>/data/processed/data-engineering/quality_report.json
# Uncomment and customize paths for separately hosted data files.
# VESTIGIUM_DB=/absolute/path/to/vestigium_hotspots.sqlite
# VESTIGIUM_MONTHLY_CSV=/absolute/path/to/monthly_sensor.csv
# VESTIGIUM_CALENDAR_CSV=/absolute/path/to/harmonized_calendar_monthly.csv
# VESTIGIUM_QUALITY_JSON=/absolute/path/to/quality_report.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
